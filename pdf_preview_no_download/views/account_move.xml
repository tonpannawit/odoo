<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="veera_view_move_form" model="ir.ui.view">
		<field name="name">veera.account.move.form</field>
		<field name="model">account.move</field>
		<field name="inherit_id" ref="account.view_move_form"/>
		<field name="arch" type="xml">
			<xpath expr="//button[@name='button_cancel']" position="before">
				<button name="view_report_preview" type="object" class="oe_highlight" string="Print Unpaid Invoice" />
				<button name="view_report_preview_with_payments" type="object" class="oe_highlight" string="Print Paid Invoice" />
			</xpath>
			
		</field>
	</record>
</odoo>